{
  "expo": {
    "name": "My View",
    "slug": "my-view",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rayees.arviewer",
      "infoPlist": {
        "NSCameraUsageDescription": "My View uses your camera to place 3D objects in your room.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "icon": "./assets/icon.png",
      "buildNumber": "2"
    },
    "android": {
      "package": "com.rayees.arviewer"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "My View uses your camera to place 3D objects in your room.",
            "microphoneUsagePermission": "My View does not record audio.",
            "photosPermission": "My View can read photos for AR experiences.",
            "savePhotosPermission": "My View can save screenshots of your AR scene."
          }
        }
      ],
      "./plugins/withAppIntents"
    ],
    "icon": "./assets/icon.png",
    "scheme": "myview"
  }
}
